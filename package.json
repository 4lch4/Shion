{
  "name": "shion-workspace",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:4lch4/Shion.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome ci .",
    "check:bun-version": "bun run scripts/check-bun-version.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
