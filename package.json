{
  "name": "shion-workspace",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:4lch4/Shion.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "check": "biome ci .",
    "check:bun-version": "bun run scripts/check-bun-version.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version && bun install --lockfile-only --ignore-scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@sinclair/typebox": "^0.34.52",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
