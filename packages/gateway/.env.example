DISCORD_APP_ID=your-application-id
DISCORD_APP_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-test-server-id

# The single Discord user Shion delivers Messages to.
# Developer Mode -> right-click yourself -> Copy User ID.
# The bot must share a server with you, or Discord refuses to open the DM.
RECIPIENT_USER_ID=your-user-id

# Required. Generate one with: openssl rand -hex 32
# Shion refuses to start without it, and every /v1 request needs
# "Authorization: Bearer <this value>". Do not reuse the value below.
API_TOKEN=generate-with-openssl-rand-hex-32

# Optional. Defaults shown.
API_PORT=3000
API_HOST=0.0.0.0
