DISCORD_APP_ID=my-application-id
DISCORD_APP_TOKEN=my-bot-token
DISCORD_GUILD_ID=my-test-guild-id

# My Discord user ID; Shion delivers every Notification to me.
# Developer Mode -> right-click my name -> Copy User ID.
# The bot must share a guild with me, or Discord refuses to open the DM.
RECIPIENT_USER_ID=my-user-id

# Required. Generate one with: openssl rand -hex 32
# Shion refuses to start without it, and every /v1 request needs
# "Authorization: Bearer <this value>". Do not reuse the value below.
API_TOKEN=generate-with-openssl-rand-hex-32

# Optional. Defaults shown.
API_PORT=3000
API_HOST=0.0.0.0
