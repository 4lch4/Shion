DISCORD_APP_ID=my-application-id
DISCORD_APP_TOKEN=my-bot-token
DISCORD_GUILD_ID=my-test-guild-id

# Required. The Discord category Notifications are delivered into.
# Developer Mode -> right-click the Category -> Copy Channel ID.
# Shion refuses to start without it.
DISCORD_CATEGORY_ID=my-category-id

# My Discord user ID. Shion mentions me in critical Notifications and falls back to my DM.
# Developer Mode -> right-click my name -> Copy User ID.
# The bot must share a guild with me, or Discord refuses to open the DM.
RECIPIENT_USER_ID=my-user-id

# Required. Generate one with: openssl rand -hex 32
# Shion refuses to start without it, and every /v1 request needs
# "Authorization: Bearer <this value>". Do not reuse the value below.
API_TOKEN=generate-with-openssl-rand-hex-32

# Optional. Defaults shown.
API_PORT=3000
API_HOST=0.0.0.0

# PostHog product analytics. Required to capture gateway events.
POSTHOG_PROJECT_TOKEN=phc_your-project-token
POSTHOG_HOST=https://your-posthog-host
