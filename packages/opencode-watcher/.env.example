# The OpenCode watcher's own settings. It sends Messages to the Gateway, so it
# needs the same API_TOKEN the Gateway uses.
# Generate one with: openssl rand -hex 32
API_TOKEN=generate-with-openssl-rand-hex-32

# Optional. Defaults shown.
# SHION_URL=http://localhost:3000
# OPENCODE_WATCHER_POLL_INTERVAL_SECONDS=300
# OPENCODE_WATCHER_STATE_FILE=data/opencode-watcher.json
# OPENCODE_WATCHER_HEARTBEAT_FILE=/app/data/heartbeat
